# Keystore Configuration Template
# 
# SECURITY WARNING: 
# - DO NOT commit the actual keystore.properties file to Git!
# - This is a template file only. Copy it to keystore.properties and fill in your values.
# - Keep your keystore file (.jks) in a secure location and back it up!
#
# Setup Instructions:
# 1. Copy this file: cp keystore.properties.template keystore.properties
# 2. Fill in your actual keystore details below
# 3. Never commit keystore.properties or your .jks file to version control
#
# How to create a keystore:
# keytool -genkey -v -keystore hollywood-animal-master.jks -keyalg RSA -keysize 2048 -validity 10000 -alias ham-release
#
# After running the command above, it will ask for:
# - Keystore password (use a strong password!)
# - Key password (use a strong password!)
# - Your name and organization details
#
# Store these passwords securely (e.g., in a password manager)!

# Path to your keystore file (relative to project root or absolute path)
# Example: ./keystore/hollywood-animal-master.jks
storeFile=path/to/your/keystore.jks

# Keystore password
storePassword=your_keystore_password_here

# Key alias (the name you gave when creating the keystore)
keyAlias=your_key_alias_here

# Key password (might be the same as keystore password)
keyPassword=your_key_password_here
